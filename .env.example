# Copia este archivo a ".env" y completa con tus credenciales reales.
# ".env" nunca debe subirse a git (ya está en .gitignore).

DB_USERNAME=tu_usuario_oracle
DB_PASSWORD=tu_password_oracle
DB_DATABASE=alias_tns_de_tu_wallet

# true en desarrollo local, false en producción (nunca mostrar errores al público)
APP_DEBUG=false
