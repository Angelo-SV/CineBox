# Bloquear acceso directo a archivos ocultos (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

# RewriteBase se detecta automáticamente a partir del directorio donde vive
# este .htaccess (funciona igual en una subcarpeta local o en la raíz del dominio).

# No reescribir archivos reales
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo va a index.php
RewriteRule ^ index.php [L]